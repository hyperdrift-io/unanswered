{
  "name": "unanswered",
  "version": "0.1.0",
  "description": "Find the open-source maintainers who asked for help and got nothing. Gemini matches them to what you know and drafts your first reply.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "waku dev",
    "build": "waku build",
    "start": "waku start --port ${PORT:-8080} --host ${HOST:-127.0.0.1}",
    "mcp": "node --env-file=.env --experimental-strip-types mcp/server.ts",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts",
    "typegen": "waku router typegen"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "hono": "^4.12.14",
    "react": "~19.2.6",
    "react-dom": "~19.2.6",
    "react-server-dom-webpack": "~19.2.6",
    "waku": "1.0.0-beta.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^6.0.3"
  }
}
